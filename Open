# ===========================
# OpenClash 修正版配置文件
# ===========================

# 常规信息
port: 7890
socks-port: 7891
redir-port: 7892
tproxy-port: 7893
mode: Rule
log-level: info
[cite_start]allow-lan: true [cite: 1, 2]
bind-address: "*"
external-controller: 0.0.0.0:9090
secret: ""

# DNS 设置
dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  [cite_start]enhanced-mode: fake-ip [cite: 2]
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - [cite_start]https://doh.pub/dns-query [cite: 2]
  fallback:
    - https://1.1.1.1/dns-query
    - [cite_start]https://8.8.8.8/dns-query [cite: 2, 3]
  fallback-filter:
    geoip: true
    [cite_start]geoip-code: CN [cite: 3]

# 节点配置 (全部合并在 proxies 下)
proxies:
  http://192.168.100.1:3001/CKg2abstVnOeRpm1aB4G/download/collection/xbo?target=sing-box

# 节点组 (必须引用 proxies 中定义的 name)
proxy-groups:
  - name: "🚀 代理转发"
    type: select
    proxies:
      - "自动选择"
      - "裸云德国"
      - "CCS"
      - "TW"
      - [cite_start]DIRECT [cite: 3, 4]

  - name: "自动选择"
    type: url-test
    proxies:
      - "裸云德国"
      - "CCS"
      - "TW"
    url: http://www.gstatic.com/generate_204
    [cite_start]interval: 300 [cite: 3]

  - name: "国内直连"
    type: select
    proxies:
      - DIRECT
      - [cite_start]"🚀 代理转发" [cite: 4]

# 规则
rules:
  - GEOIP,CN,国内直连
  - [cite_start]MATCH,🚀 代理转发 [cite: 4]
